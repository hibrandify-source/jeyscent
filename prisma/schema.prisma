generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String         @id @default(cuid())
  name          String
  email         String         @unique
  password      String
  role          String         @default("customer")
  createdAt     DateTime       @default(now())
  orders        Order[]
  subscriptions Subscription[]
}

model Order {
  id              String      @id @default(cuid())
  userId          String?
  user            User?        @relation(fields: [userId], references: [id])
  items           OrderItem[]
  total           Float
  status          String      @default("pending")
  paymentRef      String?
  shippingAddress String
  shippingCity    String
  shippingState   String
  phone           String
  email           String
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
}

model OrderItem {
  id        String @id @default(cuid())
  orderId   String
  order     Order  @relation(fields: [orderId], references: [id])
  productId String
  name      String
  size      String
  quantity  Int
  price     Float
}

model Subscription {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id])
  productId    String
  productName  String
  size         String
  frequency    String   @default("quarterly")
  status       String   @default("active")
  price        Float
  nextDelivery DateTime
  createdAt    DateTime @default(now())
}

model BlogPost {
  id        String   @id @default(cuid())
  title     String
  slug      String   @unique
  excerpt   String
  content   String
  image     String
  author    String   @default("Jey Scent")
  published Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}


model Subscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}